<mxfile host="app.diagrams.net"><diagram name="v2_hinh_2_1_kien_truc" id="v2_hinh_2_1_kien_truc"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Văn bản JD j và tập CV {cᵢ}&lt;/b&gt;&lt;br&gt;lặp cho mọi cặp (cᵢ, j) ở M1–M4;&lt;br&gt;M5–M7 dùng kết quả của các cặp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;M1. Trích xuất (LLM, schema JSON)&lt;/b&gt;&lt;br&gt;JD → yêu cầu: nội dung, loại, bắt buộc/ưu tiên,&lt;br&gt;số năm tối thiểu; CV → mục: nội dung, loại,&lt;br&gt;số năm, cấp độ; cấp độ và tổng số năm; cache" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;M2. Biểu diễn từng yêu cầu / mục&lt;/b&gt;&lt;br&gt;ESCO (tùy chọn, τ = 0,85) → BGE-M3 (1024 chiều)&lt;br&gt;+ one-hot loại, cờ bắt buộc, số năm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;M3. Đồ thị mức yêu cầu&lt;/b&gt;&lt;br&gt;nút: yêu cầu JD, mục CV, 4 nút cấp độ/số năm;&lt;br&gt;cạnh khớp: yêu cầu → mục cùng loại,&lt;br&gt;top-m = 3 theo cosine (thuộc tính = cosine)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;M4. Mô hình chấm điểm&lt;/b&gt;&lt;br&gt;điểm cạnh = MLP(yêu cầu, mục) + đường tắt cosine;&lt;br&gt;độ phủ c_r = max trên cạnh của yêu cầu r;&lt;br&gt;trọng số w_r = attention (theo cờ bắt buộc);&lt;br&gt;s = k·Σ w_r·σ(c_r) + b − phạt thiếu&lt;br&gt;cấp độ / số năm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="290" width="300" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;M5. Phân mức 0–3&lt;/b&gt;&lt;br&gt;quy điểm s về mức 0–3&lt;br&gt;theo phân vị trong từng JD" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="300" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;M7. Diễn giải từ đồ thị&lt;/b&gt;&lt;br&gt;yêu cầu đã đáp ứng (σ(c_r) ≥ 0,5) / chưa;&lt;br&gt;bằng chứng = mục CV của cạnh có điểm&lt;br&gt;cao nhất; mức quan trọng = w_r" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="300" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;M6. Xếp hạng&lt;/b&gt;&lt;br&gt;gom các cặp cùng một JD;&lt;br&gt;sắp CV theo s giảm dần" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="300" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Đầu ra&lt;/b&gt;&lt;br&gt;điểm s và mức (0–3) của từng cặp;&lt;br&gt;danh sách CV của mỗi JD;&lt;br&gt;lời diễn giải: yêu cầu đã / chưa&lt;br&gt;đáp ứng kèm bằng chứng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="300" height="170" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="w_r, c_r, điểm cạnh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="s, mức" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="danh sách xếp hạng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="lời diễn giải" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;entryX=1;entryY=0.6;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Bước 1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="590" y="32" width="90" height="24" as="geometry"/></mxCell><mxCell id="c20" value="Bước 2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="940" y="32" width="90" height="24" as="geometry"/></mxCell><mxCell id="c21" value="Bước 3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1290" y="32" width="90" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Bước 3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1290" y="262" width="90" height="24" as="geometry"/></mxCell><mxCell id="c23" value="Bước 4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="940" y="262" width="90" height="24" as="geometry"/></mxCell><mxCell id="c24" value="Bước 4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="940" y="442" width="90" height="24" as="geometry"/></mxCell><mxCell id="c25" value="Bước 5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="590" y="262" width="90" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Chỉ dùng khi có nhãn (huấn luyện, chọn mô hình, đánh giá)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#777777;strokeWidth=1.5;verticalAlign=top;align=center;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1460" height="250" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Nhãn y&lt;/b&gt;&lt;br&gt;y = 0, 1, 2, 3&lt;br&gt;(mức phù hợp của cặp)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="250" height="130" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Huấn luyện M4&lt;/b&gt;&lt;br&gt;loss xếp hạng RankNet theo từng JD:&lt;br&gt;cặp (CV tốt hơn, CV kém hơn) cùng JD,&lt;br&gt;trọng số = chênh nhãn; AdamW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="770" width="340" height="130" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Validation (15% JD của tập huấn luyện)&lt;/b&gt;&lt;br&gt;dừng sớm theo val loss;&lt;br&gt;chọn cấu hình theo NDCG@10 validation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="730" y="770" width="330" height="130" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Đánh giá (tập kiểm tra, chấm một lần)&lt;/b&gt;&lt;br&gt;NDCG@5/10, MAP, MRR, Recall@5,&lt;br&gt;Spearman, QWK; paired bootstrap, Holm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="350" y="770" width="330" height="130" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="925"/><mxPoint x="515" y="925"/></Array></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="925"/><mxPoint x="895" y="925"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="925"/><mxPoint x="1280" y="925"/></Array></mxGeometry></mxCell><mxCell id="c34" value="cập nhật tham số" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c28" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="điểm, mức, danh sách" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="680"/><mxPoint x="515" y="680"/></Array></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;Chú giải màu:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="110" height="30" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="140" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c38" value="Đầu vào / đầu ra" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="168" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="335" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c40" value="Trích xuất, biểu diễn" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="363" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c42" value="Dựng đồ thị" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="558" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="725" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c44" value="Tính điểm" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="753" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c46" value="Phân mức, diễn giải" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="948" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1115" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c48" value="Xếp hạng" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1143" y="980" width="163" height="30" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1310" y="985" width="22" height="20" as="geometry"/></mxCell><mxCell id="c50" value="Chỉ dùng khi có nhãn" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1338" y="980" width="163" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>