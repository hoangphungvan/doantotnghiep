<mxfile host="app.diagrams.net"><diagram name="v2_hinh_1_1_cv_jd_pipeline" id="v2_hinh_1_1_cv_jd_pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Đầu vào (Input)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#777777;strokeWidth=1.5;verticalAlign=top;align=center;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="290" height="690" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Xử lý (Process)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#777777;strokeWidth=1.5;verticalAlign=top;align=center;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="440" height="690" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Đầu ra (Output)&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#777777;strokeWidth=1.5;verticalAlign=top;align=center;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="870" y="20" width="290" height="690" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Một JD (j) và tập CV ứng viên (c)&lt;/b&gt;&lt;br&gt;văn bản tiếng Việt, tiếng Anh&lt;br&gt;hoặc song ngữ; lặp cho mọi cặp (c, j)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Nhãn mức phù hợp y&lt;/b&gt;&lt;br&gt;y = 0, 1, 2, 3 (tùy chọn:&lt;br&gt;chỉ dùng khi huấn luyện, đánh giá)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="250" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Bước 1. Trích xuất yêu cầu và mục&lt;/b&gt;&lt;br&gt;JD → yêu cầu (nội dung, loại, bắt buộc/ưu tiên, số năm);&lt;br&gt;CV → mục (nội dung, loại, số năm, cấp độ)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="65" width="400" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Bước 2. Biểu diễn từng yêu cầu, từng mục&lt;/b&gt;&lt;br&gt;embedding đa ngữ cho mỗi yêu cầu / mục&lt;br&gt;(chuẩn hóa kỹ năng theo ESCO: tùy chọn)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="190" width="400" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Bước 3. Đối sánh mức yêu cầu, tính điểm&lt;/b&gt;&lt;br&gt;đồ thị yêu cầu–mục; độ phủ từng yêu cầu,&lt;br&gt;cộng có trọng số, phạt thiếu cấp độ/số năm → s(c, j)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="315" width="400" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Bước 4. Phân mức, sinh diễn giải&lt;/b&gt;&lt;br&gt;quy điểm về mức 0–3; yêu cầu đã / chưa đáp ứng&lt;br&gt;và bằng chứng lấy từ chính các cạnh của đồ thị" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="440" width="400" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Bước 5. Xếp hạng CV theo từng JD&lt;/b&gt;&lt;br&gt;gom điểm các cặp cùng một JD,&lt;br&gt;sắp xếp CV theo điểm giảm dần" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="565" width="400" height="100" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="huấn luyện" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.6;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="chọn ngưỡng, đánh giá" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.6;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Điểm phù hợp s(c, j)&lt;/b&gt;&lt;br&gt;của từng cặp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="320" width="250" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Mức phù hợp (0–3)&lt;/b&gt;&lt;br&gt;của từng cặp" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="425" width="250" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Lời diễn giải&lt;/b&gt;&lt;br&gt;yêu cầu đã / chưa đáp ứng, bằng chứng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="505" width="250" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Danh sách CV của mỗi JD&lt;/b&gt;&lt;br&gt;xếp theo điểm giảm dần" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="590" width="250" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Chú giải màu:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="110" height="30" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="140" y="735" width="22" height="20" as="geometry"/></mxCell><mxCell id="c28" value="Dữ liệu vào" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="168" y="730" width="138" height="30" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="735" width="22" height="20" as="geometry"/></mxCell><mxCell id="c30" value="Trích xuất, biểu diễn" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="338" y="730" width="138" height="30" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="735" width="22" height="20" as="geometry"/></mxCell><mxCell id="c32" value="Tính điểm" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="508" y="730" width="138" height="30" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="735" width="22" height="20" as="geometry"/></mxCell><mxCell id="c34" value="Phân mức, diễn giải" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="678" y="730" width="138" height="30" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="735" width="22" height="20" as="geometry"/></mxCell><mxCell id="c36" value="Xếp hạng" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;font