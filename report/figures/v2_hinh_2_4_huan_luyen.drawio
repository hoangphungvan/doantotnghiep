<mxfile host="app.diagrams.net"><diagram name="v2_hinh_2_4_huan_luyen" id="v2_hinh_2_4_huan_luyen"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Dữ liệu huấn luyện&lt;/b&gt;&lt;br&gt;đồ thị cặp (CV, JD) và nhãn y; tập huấn luyện&lt;br&gt;tách 85% JD train / 15% JD validation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="360" height="110" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Khởi tạo tham số θ&lt;/b&gt;&lt;br&gt;mặc định PyTorch; đường tắt cosine: lớp cuối MLP cạnh = 0,&lt;br&gt;hệ số 10, ngưỡng 0,5 (bắt đầu đúng như MaxSim);&lt;br&gt;phạt cấp độ / số năm: trọng số 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="480" height="110" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Vòng epoch: tối đa 80 epoch&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#777777;strokeWidth=1.5;verticalAlign=top;align=right;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="1460" height="760" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Vòng lô: mỗi lô gom mọi cặp của 8 JD&lt;/b&gt;" style="rounded=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=1.5;verticalAlign=top;align=right;html=1;fontFamily=Times New Roman;fontSize=14;spacingTop=6;spacingRight=10;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1420" height="290" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Lan truyền xuôi&lt;/b&gt;&lt;br&gt;chiếu nút → điểm từng cạnh khớp&lt;br&gt;→ max theo yêu cầu (c_r)&lt;br&gt;→ attention w_r → điểm s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="290" height="160" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Hàm mất mát RankNet&lt;/b&gt;&lt;br&gt;mọi cặp (i, j) cùng JD có y_i &gt; y_j:&lt;br&gt;softplus(−(s_i − s_j)),&lt;br&gt;trọng số y_i − y_j" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="290" height="160" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Lan truyền ngược&lt;/b&gt;&lt;br&gt;tính gradient của L theo θ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="250" height="160" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Cập nhật tham số&lt;/b&gt;&lt;br&gt;AdamW: η = 0,001;&lt;br&gt;weight decay = 0,0001" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="250" height="160" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Còn lô?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="320" width="150" height="120" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="150"/><mxPoint x="205" y="150"/></Array></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="Có: lô kế tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;e