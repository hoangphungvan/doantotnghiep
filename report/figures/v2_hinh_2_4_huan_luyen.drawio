strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Không: epoch kế" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="c19" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="645"/><mxPoint x="50" y="396"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Kết thúc huấn luyện&lt;/b&gt;&lt;br&gt;nạp lại trạng thái tốt nhất → mô hình chấm điểm;&lt;br&gt;NDCG@10 validation để chọn cấu hình" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="980" width="360" height="120" as="geometry"/></mxCell><mxCell id="c25" value="Có: dừng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Ký hiệu: s = điểm phù hợp của cặp (logit, không giới hạn);&lt;br&gt;y = mức phù hợp của cặp (nhãn của bộ dữ liệu); c_r = độ phủ (logit) của yêu cầu r;&lt;br&gt;w_r = trọng số attention của yêu cầu r (tổng bằng 1 trong mỗi đồ thị)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="690" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Chú giải màu:&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="1120" width="110" height="30" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="140" y="1125" width="22" height="20" as="geometry"/></mxCell><mxCell id="c29" value="Dữ liệu / kết quả" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="168" y="1120" width="158" height="30" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="1125" width="22" height="20" as="geometry"/></mxCell><mxCell id="c31" value="Lan truyền xuôi" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="358" y="1120" width="158" height="30" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="1125" width="22" height="20" as="geometry"/></mxCell><mxCell id="c33" value="Hàm mất mát" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="548" y="1120" width="158" height="30" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;" ve